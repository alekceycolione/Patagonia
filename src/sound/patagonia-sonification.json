  "interpretation_guide": {
    "wind_db": "intensidade do ruído de vento (white/pink noise filtrado). Mais perto de 0 = mais alto",
    "drone_db": "amplitude do drone harmônico (5 parciais em F#m). Pico em ~frame 135 (db 8)",
    "shimmer_n": "número de grãos high-freq por segundo. Pico em ~frame 100 (n=8)",
    "sub_db": "presença do sub grave 30Hz. Aparece em frame 61, some em frame 171. Reforça 'peso' da estepe",
    "pan": "posição no campo stereo. -1 = esquerda, 0 = centro, 1 = direita. Drifts como nuvem passando",
    "mood": "palavra-poética para a vibe do frame. Útil pra buscar samples ou guiar um sound designer",
    "texture": "palavra-tátil que sugere o material soando (areia, musgo, gelo, cristal, estepe)"
  }
